class Input:
    """Collect and validate a car selection from the menu."""

    VALID_CHOICES = {"1", "2", "3", "4", "5", "6", "7"}

    @classmethod
    def get_choice(cls, prompt="Please enter the number corresponding to your choice: "):
        choice = input(prompt).strip()
        return choice if choice in cls.VALID_CHOICES else None


